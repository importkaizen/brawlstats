# --- Database -----------------------------------------------------------
# Default: SQLite. Works out of the box with `npm run db:push`.
DATABASE_URL="file:./dev.db"
#
# Postgres alternative (production-style). Change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql" and use a connection
# URL like:
#   DATABASE_URL="postgresql://postgres:pw@localhost:5432/myrebrawl?schema=public"

# --- Brawl Stars API ----------------------------------------------------
# Required for live data. Create one at https://developer.brawlstars.com.
# The key is bound to the IP it was created with, so whitelist your dev IP
# (and a fixed-IP proxy for production — see BRAWLSTARS_PROXY_URL below).
BRAWLSTARS_API_KEY=

# Optional second key: tried when the other key is rejected (401/403).
# Each key must allow the outbound IP it is meant to serve.
BRAWLSTARS_API_KEY_BACKUP=

# Optional: a fixed-IP HTTP proxy that forwards Authorization to the BS
# API. Useful when deploying to Vercel where outbound IPs are dynamic.
# BRAWLSTARS_PROXY_URL=https://my-proxy.example.com

# --- App ----------------------------------------------------------------
# Required in production: random secret Vercel Cron sends as Authorization: Bearer …
CRON_SECRET=please-change-me

# Public site URL — OG metadata and Brawl Stars API User-Agent contact origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js (next-auth v5) ---------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional Discord (both → shows button on /login)
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
